@{
    ViewData["Title"] = "Animal Classifier";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="text-center mb-5">
                <h1 class="display-4 fw-bold">🐾 Animal Classifier</h1>
                <p class="lead text-muted">
                    Класифікація зображень за допомогою ML.NET
                </p>
            </div>

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <form asp-action="Index"
                          asp-controller="Home"
                          method="post"
                          enctype="multipart/form-data">

                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                📷 Завантажити фотографію
                            </label>

                            <input type="file"
                                   name="image"
                                   class="form-control form-control-lg"
                                   accept="image/png,image/jpeg,image/jpg" />
                        </div>

                        <div class="text-center my-3">
                            <span class="text-muted">або</span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                🔗 Посилання на зображення
                            </label>

                            <input type="url"
                                   name="imageUrl"
                                   class="form-control form-control-lg"
                                   placeholder="https://example.com/image.jpg" />
                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100 rounded-3">
                            🔍 Класифікувати зображення
                        </button>

                    </form>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mt-4">
                            <strong>Помилка:</strong>
                            @ViewBag.Error
                        </div>
                    }

                    @if (ViewBag.PredictedLabel != null)
                    {
                        <div class="result-box mt-5">

                            <div class="text-center">
                                <h2 class="fw-bold mb-4">
                                    🎉 Результат
                                </h2>

                                <div class="result-label">
                                    @ViewBag.PredictedLabel
                                </div>

                                <div class="mt-4">
                                    <h5 class="text-muted">
                                        Впевненість моделі
                                    </h5>

                                    <div class="progress mt-3"
                                         style="height: 30px;">

                                        <div class="progress-bar"
                                             role="progressbar"
                                             style="width: @ViewBag.Confidence.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%">

                                            @ViewBag.Confidence.ToString("F1")%
                                        </div>

                                    </div>
                                </div>
                            </div>

                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>